# 配置模板：复制为 .env.local 并填写真实值（.env.local 不入 git）
# 共享项 + BOTS 列表（每个机器人一项，可配置多个实现单进程多机器人）
# 一 chat_id 一 work_dir：每个机器人绑定一个群 + 一个工作目录；chat_id 唯一
# work_dir 可省略，省略则用家目录 ~
# 数据库为 MySQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
TASK_TIMEOUT=600
# 长任务心跳：处理期间每隔多少秒回一条「仍在处理中」，0=关闭（间隔会逐步加倍，上限 10 分钟）
HEARTBEAT_INTERVAL=60
# 全局并发上限：所有机器人同时运行的 claude 进程数上限（不同 chat_id 并行、同一 chat_id 串行）
# 按内存/CPU 估：每个 claude 约几百 MB~1G，16G/4 核建议 3~4
MAX_CONCURRENT=3
# 自动压缩阈值：续聊时若当前对话 context 占用达此百分比，先把历史摘要成一段上下文、
# 开新对话再执行（省额度，不用手动 /new）。0=关闭，改由 92% 硬闸兜底（触顶暂停、要求手动）。
AUTO_COMPACT_THRESHOLD=75
# /model 可选模型清单（可选，留空用默认 opus/sonnet/haiku）
MODELS=["fable","opus","sonnet","haiku"]
# ===== 飞书知识库 RAG（只有 BOTS 里配了 wiki 字段的机器人才用到）=====
# 索引缓存目录：必须在 work_dir 之外——gitsync 每轮 git add -A，
# 镜像落进 work_dir 会被整个提交进你的 git 历史
WIKI_CACHE_DIR=~/.feishu-bot/wiki
# 后台自动增量同步间隔（秒）
WIKI_SYNC_INTERVAL=1800
# embedding 服务（ollama）与模型。换模型会改变向量维度，需 --rebuild 全量重建索引
WIKI_EMBED_URL=http://localhost:11434
WIKI_EMBED_MODEL=quentinz/bge-small-zh-v1.5
WIKI_EMBED_KEEP_ALIVE=30m
# BOTS 支持多行 JSON（会自动拼接到括号闭合），方便编辑；每个机器人一项
# 可选字段：
#   sync_patch  bool  每轮任务后自动把 work_dir 的增量改动打成 git bundle 发到群
#   extra_dirs  []    额外挂进工作区的只读目录（--add-dir）。cwd 仍是 work_dir，
#                     产物不会落进这些目录；用于「让 Claude 能读某个项目的源码，
#                     但对话产物不污染那个项目」的场景
#   wiki        {}    绑定一个飞书知识库做 RAG：{"space_id":"7xxx","root_node":"可选子树",
#                     "top_k":5}。space_id 用 /wiki spaces 或
#                     `python -m wiki_sync --env local --bot <name> --spaces` 拿
BOTS=[
  {"name":"bot1","app_id":"","app_secret":"","chat_id":"","work_dir":"/abs/path",
   "extra_dirs":["/abs/other/project"]},
  {"name":"wiki","app_id":"","app_secret":"","chat_id":"","work_dir":"/abs/wiki-workdir",
   "wiki":{"space_id":"","top_k":5}}
]
